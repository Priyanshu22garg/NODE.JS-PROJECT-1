async function addPost() {
    await fetch("/posts", {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        body: JSON.stringify({
            link: link.value,
            description: description.value
        })
    });

    getPosts();
}

async function getPosts() {
    const res = await fetch("/posts");
    const posts = await res.json();

    postsDiv.innerHTML = posts.map(p => `
        <div>
            <a href="${p.link}" target="_blank">${p.link}</a>
            <p>${p.description}</p>

            <input id="c${p.id}" placeholder="Comment">
            <button onclick="addComment(${p.id})">Comment</button>

            <div id="comments${p.id}"></div>
        </div>
    `).join("");

    posts.forEach(p => getComments(p.id));
}

async function addComment(id) {
    await fetch(`/posts/${id}/comments`, {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        body: JSON.stringify({
            comment: document.getElementById(`c${id}`).value
        })
    });

    getComments(id);
}

async function getComments(id) {
    const res = await fetch(`/posts/${id}/comments`);
    const comments = await res.json();

    document.getElementById(`comments${id}`).innerHTML =
        comments.map(c => `<p>${c.comment}</p>`).join("");
}

getPosts();








